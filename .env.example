# Claude – writes the report. Without it the app uses a deterministic mock report.
ANTHROPIC_API_KEY=
# Two-stage read: NOTES_MODEL reads the whole chat in chunks, REPORT_MODEL writes the report
NOTES_MODEL=claude-haiku-5-5
REPORT_MODEL=claude-sonnet-5-5
# Postgres (Neon). Without it, a local file store is used (dev only)
DATABASE_URL=
# 1 = show the OTP on screen and skip payment (testing before Stripe / email are set up)
DEMO_MODE=
# Stripe – without it, checkout is mocked (dev only)
STRIPE_SECRET_KEY=
# Price in agorot (₪15 = 1500)
REPORT_PRICE_AGOROT=1500
# Public base URL (for Stripe redirects / OG)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Protects /api/cron/cleanup (Vercel Cron sends it as Bearer)
CRON_SECRET=
